# Reference only: `sh lab configure` writes a private external lab.env.
# Values are literal; no shell execution or variable substitution.
VMFORECAST_GOOGLE_CLOUD_PROJECT=
# Public dataset owner, not the participant's Sandbox project.
VMFORECAST_SOURCE_PROJECT=google.com:google-cluster-data
# Empty paths use XDG defaults, isolated for this checkout.
VMFORECAST_STATE_DIR=
VMFORECAST_DATA_DIR=
VMFORECAST_RUNS_DIR=
VMFORECAST_MIN_FREE_GIB=3
# gcloud is found in PATH; configure accepts a custom executable path.
VMFORECAST_GCLOUD_BIN=gcloud
